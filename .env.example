# Generate a long random value for every deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Required to permit hospital staff account creation.
HOSPITAL_REGISTRATION_CODE=replace-with-a-private-invitation-code
# Set to 1 when served over HTTPS (Render sets this in render.yaml).
COOKIE_SECURE=0
# Optional: omit for local SQLite; set to PostgreSQL URL for cloud hosting.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mediflow
